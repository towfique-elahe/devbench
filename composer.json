{
	"name": "towfique-elahe/devbench",
	"description": "An all-in-one developer workbench for WordPress: debug tools, file manager, database browser, search, mail catcher and environment checks.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/towfique-elahe/devbench",
	"authors": [
		{
			"name": "Towfique Elahe",
			"homepage": "https://towfiqueelahe.com"
		}
	],
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml ."
	}
}
